        .jv-messages{flex:1; overflow-y:auto; padding:16px 18px; display:flex; flex-direction:column; gap:12px;}
        .jv-msg{max-width:88%; padding:10px 13px; border-radius:12px; font-size:13.5px; line-height:1.5;}
        .jv-msg p{margin:0 0 6px 0; white-space:pre-wrap;}
        .jv-msg-time{font-size:10px; color:var(--muted);}
        .jv-msg.assistant{align-self:flex-start; background:var(--panel-2); border:1px solid var(--border); border-top-left-radius:2px;}
        .jv-msg.user{align-self:flex-end; background:linear-gradient(135deg, rgba(63,208,242,0.22), rgba(63,208,242,0.08)); border:1px solid var(--cyan-dim); border-top-right-radius:2px;}
        .jv-msg.thinking{display:flex; align-items:center; padding:12px 16px;}
        .jv-typing{display:flex; gap:4px;}
        .jv-typing span{width:5px; height:5px; border-radius:50%; background:var(--muted); animation:breathe 1s infinite;}
        .jv-typing span:nth-child(2){animation-delay:0.2s;}
        .jv-typing span:nth-child(3){animation-delay:0.4s;}

        .jv-input-row{display:flex; align-items:center; gap:10px; padding:14px 18px; border-top:1px solid var(--border); flex-shrink:0;}
        .jv-input{
          flex:1; background:var(--panel-2); border:1px solid var(--border); border-radius:10px; padding:11px 14px;
          color:var(--text); font-size:13.5px; font-family:inherit;
        }
        .jv-input::placeholder{color:var(--muted);}
        .jv-input:focus{outline:none; border-color:var(--cyan-dim);}
        .jv-send-btn{
          width:40px; height:40px; border-radius:10px; background:var(--cyan); border:none; color:#04141c;
          display:flex; align-items:center; justify-content:center; cursor:pointer; flex-shrink:0;
        }
        .jv-send-btn:disabled{background:var(--panel-2); color:var(--muted); cursor:not-allowed;}

        @keyframes pulseRing{0%{transform:scale(0.9); opacity:0.7;}70%{transform:scale(1.05); opacity:0.15;}100%{transform:scale(0.9); opacity:0.7;}}
        @keyframes breathe{0%,100%{opacity:0.4;}50%{opacity:1;}}
        @keyframes barBounce{0%,100%{transform:scaleY(0.35);}50%{transform:scaleY(1);}}

        .jv-root :focus-visible{outline:2px solid var(--cyan); outline-offset:2px;}

        @media (prefers-reduced-motion: reduce){
          .jv-root *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important;}
        }

        @media (max-width: 1000px){
          .jv-body{grid-template-columns:1fr; overflow-y:auto;}
          .jv-center{order:1;}
          .jv-chat{order:2; height:480px;}
          .jv-sidebar{order:3; overflow-y:visible;}
          .jv-header{padding:12px 16px;}
          .jv-logo{font-size:16px;}
        }
        @media (max-width: 480px){
          .jv-orb-wrap{width:180px; height:180px;}
          .jv-orb-core{width:96px; height:96px;}
          .jv-title{font-size:19px; letter-spacing:4px;}
          .jv-clock{font-size:11px;}
          .jv-chip span:last-child{display:none;}
        }
      `}</style>

      <header className="jv-header">
        <div className="jv-brand">
          <span className="jv-logo">J·A·R·V·I·S</span>
          <span className="jv-status-pill online">
            <span className="dot" /> Online
          </span>
        </div>
        <div className="jv-clock">
          <Clock size={15} />
          <span className="mono">{timeStr}</span>
          <span className="sep">|</span>
          <span>{dateStr}</span>
        </div>
        <div className="jv-header-right">
          <div className="jv-chip">
            <Cloud size={14} />
            <span className="mono">{weather.temp.toFixed(1)}°C</span>
            <span className="muted">{weather.cityShort}</span>
          </div>
          <div className="jv-settings-wrap">
            <button
              className="jv-icon-btn"
              type="button"
              onClick={() => setSettingsOpen((o) => !o)}
              aria-label="Settings"
            >
              <Settings size={18} />
            </button>
            {settingsOpen && (
              <div className="jv-settings-pop">
                <label className="jv-toggle-row">
                  <span>Voice replies</span>
                  <input
                    type="checkbox"
                    checked={soundOn}
                    onChange={(e) => setSoundOn(e.target.checked)}
                  />
                </label>
                <label className="jv-toggle-row">
                  <span>Auto-scroll</span>
                  <input
                    type="checkbox"
                    checked={autoScroll}
                    onChange={(e) => setAutoScroll(e.target.checked)}
                  />
                </label>
              </div>
            )}
          </div>
        </div>
      </header>

      <div className="jv-body">
        <aside className="jv-sidebar">
          <div className="jv-card">
            <div className="jv-card-head">
              <span className="jv-card-title">
                <Cpu size={15} /> System Stats
              </span>
              <button
                className="jv-icon-btn ghost"
                type="button"
                aria-label="Refresh system stats"
                onClick={() => {
                  setCpu((c) => clamp(c + (Math.random() * 6 - 3), 3, 38));
                  setRamUsed((r) => clamp(r + (Math.random() * 0.6 - 0.3), 4, 13));
                }}
              >
                <RefreshCw size={14} />
              </button>
            </div>
            <div className="jv-stat-row">
              <span>CPU Usage</span>
              <span className="mono">{Math.round(cpu)}%</span>
            </div>
            <div className="jv-bar">
              <div className="jv-bar-fill" style={{ width: `${cpu}%` }} />
            </div>
            <div className="jv-stat-row">
              <span>RAM Usage</span>
              <span className="mono">{ramUsed.toFixed(1)} GB</span>
            </div>
            <div className="jv-bar">
              <div className="jv-bar-fill" style={{ width: `${memPct}%` }} />
            </div>
            <div className="jv-mini-grid">
              <div className="jv-mini">
                <span className="muted">CPU</span>
                <span className="mono">{Math.round(cpu)}%</span>
              </div>
              <div className="jv-mini">
                <span className="muted">Memory</span>
                <span className="mono">{memPct}%</span>
              </div>
              <div className="jv-mini">
                <span className="muted">Disk</span>
                <span className="mono">
                  {DISK_USED_GB}/{DISK_TOTAL_GB} GB
                </span>
              </div>
            </div>
          </div>

          <div className="jv-card">
            <div className="jv-card-head">
              <span className="jv-card-title">
                <Cloud size={15} /> Weather
              </span>
              <button
                className="jv-icon-btn ghost"
                type="button"
                aria-label="Refresh weather"
                onClick={() =>
                  setWeather((w) => ({
                    ...w,
                    temp: clamp(w.temp + (Math.random() * 0.6 - 0.3), 20, 32),
                    humidity: clamp(w.humidity + (Math.random() * 4 - 2), 60, 99),
                    wind: clamp(w.wind + (Math.random() * 0.8 - 0.4), 1, 12),
                  }))
                }
              >
                <RefreshCw size={14} />
              </button>
            </div>
            <div className="jv-weather-main">
              <div>
                <div className="jv-weather-temp mono">{weather.temp.toFixed(1)}°C</div>
                <div className="jv-weather-city">{weather.city}</div>
                <div className="muted" style={{ fontSize: "12px" }}>
                  {weather.condition}
                </div>
              </div>
              <Cloud size={40} className="jv-weather-icon" />
            </div>
            <div className="jv-mini-grid">
              <div className="jv-mini">
                <span className="muted">Humidity</span>
                <span className="mono">{Math.round(weather.humidity)}%</span>
              </div>
              <div className="jv-mini">
                <span className="muted">Wind</span>
                <span className="mono">{weather.wind.toFixed(1)} m/s</span>
              </div>
              <div className="jv-mini">
                <span className="muted">Feels Like</span>
                <span className="mono">{weather.feelsLike.toFixed(1)}°C</span>
              </div>
            </div>
          </div>

          <div className="jv-card">
            <div className="jv-card-head">
              <span className="jv-card-title">
                <Camera size={15} /> Camera
              </span>
              <div className="jv-card-head-actions">
                <button
                  className="jv-icon-btn ghost"
                  type="button"
                  aria-label="Take snapshot"
                  disabled={!cameraOn}
                  onClick={handleSnapshot}
                >
                  <Camera size={14} />
                </button>
                <button
                  className="jv-icon-btn ghost"
                  type="button"
                  aria-label={cameraOn ? "Turn camera off" : "Turn camera on"}
                  onClick={toggleCamera}
                  style={cameraOn ? { color: "var(--cyan)", borderColor: "var(--cyan-dim)" } : undefined}
                >
                  <Power size={14} />
                </button>
              </div>
            </div>
            <div className="jv-camera-box">
              {cameraOn ? (
                <video ref={videoRef} autoPlay playsInline muted className="jv-camera-feed" />
              ) : (
                <div className="jv-camera-placeholder">
                  <Video size={26} />
                  <span>Camera Off</span>
                </div>
              )}
              <div className={`jv-camera-flash ${flash ? "on" : ""}`} />
            </div>
            <p className="jv-hint">
              {cameraError ||
                (cameraOn
                  ? "Live feed active. Click the power button to stop."
                  : "Camera is inactive. Click the power button to start.")}
            </p>
          </div>

          <div className="jv-card">
            <div className="jv-card-head">
              <span className="jv-card-title">
                <Timer size={15} /> System Uptime
              </span>
              <div className="jv-uptime-chip-wrap">
                <span className="mono jv-uptime-chip">{formatHMS(uptimeSec)}</span>
                <button
                  className="jv-icon-btn ghost"
                  type="button"
                  aria-label="Toggle uptime detail"
                  onClick={() => setUpExpanded((v) => !v)}
                >
                  <Maximize2 size={12} />
                </button>
              </div>
            </div>
            {upExpanded && (
              <p className="jv-started-line">
                Session started at {seedTimeRef.current.toLocaleTimeString()}
              </p>
            )}
            <div className="jv-stat-row">
              <span>System Running For:</span>
              <span className="mono">{formatHMS(uptimeSec)}</span>
            </div>
            <div className="jv-mini-grid two">
              <div className="jv-mini">
                <span className="muted">Session</span>
                <span className="mono">1</span>
              </div>
              <div className="jv-mini">
                <span className="muted">Commands</span>
                <span className="mono">{commands}</span>
              </div>
            </div>
            <div className="jv-stat-row" style={{ marginTop: "12px" }}>
              <span>System Load</span>
              <span className="mono">{Math.round(load)}%</span>
            </div>
            <div className="jv-bar">
              <div
                className="jv-bar-fill"
                style={{ width: `${load}%`, background: loadInfo.color }}
              />
            </div>
            <div className="jv-stat-row small">
              <span style={{ color: loadInfo.color }}>{loadInfo.label}</span>
              <span></span>
            </div>
          </div>
        </aside>

        <section className="jv-center">
          <div className={`jv-orb-wrap ${assistantStatus}`}>
            <div className="jv-orb-ring r1" />
            <div className="jv-orb-ring r2" />
            <div className="jv-orb-ring r3" />
            <div className="jv-orb-core">
              <div className="jv-eq">
                <span />
                <span />
                <span />
                <span />
                <span />
              </div>
            </div>
          </div>
          <h1 className="jv-title">J.A.R.V.I.S</h1>
          <div className={`jv-status-pill ${assistantStatus}`}>
            <span className="dot" /> {statusText}
          </div>
          <div className="jv-quick-actions">
            <button
              className={`jv-fab ${cameraOn ? "active" : ""}`}
              type="button"
              aria-label="Toggle camera"
              onClick={toggleCamera}
            >
              <Camera size={20} />
            </button>
            <button
              className={`jv-fab ${assistantStatus === "listening" ? "active" : ""}`}
              type="button"
              aria-label="Toggle microphone"
              onClick={toggleMic}
            >
              <Mic size={20} />
            </button>
            <button className="jv-fab" type="button" aria-label="Focus message input" onClick={focusInput}>
              <Keyboard size={20} />
            </button>
          </div>
          {voiceNotice && <p className="jv-voice-notice">{voiceNotice}</p>}
        </section>

        <aside className="jv-chat">
          <div className="jv-chat-head">
            <h2>Conversation</h2>
            <div className="jv-chat-actions">
              <button className="jv-pill-btn" type="button" onClick={clearConversation}>
                <Trash2 size={13} /> Clear
              </button>
              <button className="jv-pill-btn" type="button" onClick={extractConversation}>
                <Download size={13} /> Extract Conversation
              </button>
            </div>
          </div>
          <div className="jv-messages">
            {messages.map((m) => (
              <div key={m.id} className={`jv-msg ${m.role}`}>
                <p>{m.text}</p>
                <span className="jv-msg-time">
                  {m.time.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}
                </span>
              </div>
            ))}
            {assistantStatus === "thinking" && (
              <div className="jv-msg assistant thinking">
                <span className="jv-typing">
                  <span />
                  <span />
                  <span />
                </span>
              </div>
            )}
            <div ref={messagesEndRef} />
          </div>
          <div className="jv-input-row">
            <input
              ref={inputRef}
              className="jv-input"
              placeholder="Type a message..."
              value={inputValue}
              onChange={(e) => setInputValue(e.target.value)}
              onKeyDown={(e) => {
                if (e.key === "Enter" && !e.shiftKey) {
                  e.preventDefault();
                  sendMessage();
                }
              }}
              disabled={assistantStatus === "thinking" || assistantStatus === "speaking"}
            />
            <button
              className="jv-send-btn"
              type="button"
              aria-label="Send message"
              onClick={sendMessage}
              disabled={!inputValue.trim() || assistantStatus === "thinking" || assistantStatus === "speaking"}
            >
              <Send size={16} />
            </button>
          </div>
        </aside>
      </div>
    </div>
  );
}
